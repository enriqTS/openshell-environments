#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
action="${1:-install}"
BIN_DIR="${OPENSHELL_CLIENT_BIN_DIR:-${XDG_BIN_HOME:-$HOME/.local/bin}}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/openshell-clients"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

check_install_target() {
  local client="$1" source="$ROOT/bin/$1-openshell" target="$BIN_DIR/$1"
  if [[ -e "$target" || -L "$target" ]]; then
    if [[ -L "$target" && "$(readlink -f -- "$target")" == "$source" ]]; then
      return
    fi
    printf 'install-openshell-client-launchers: refusing to replace existing path: %s\n' "$target" >&2
    exit 1
  fi
}

install_launcher() {
  local client="$1" source="$ROOT/bin/$1-openshell" target="$BIN_DIR/$1"
  if [[ -L "$target" ]]; then
    printf '%s already launches OpenShell: %s\n' "$client" "$target"
    return
  fi
  ln -s -- "$source" "$target"
  printf 'installed %s -> %s\n' "$target" "$source"
}

uninstall_launcher() {
  local client="$1" source="$ROOT/bin/$1-openshell" target="$BIN_DIR/$1"
  if [[ -L "$target" && "$(readlink -f -- "$target")" == "$source" ]]; then
    rm -- "$target"
    printf 'removed %s\n' "$target"
  elif [[ -e "$target" || -L "$target" ]]; then
    printf 'install-openshell-client-launchers: refusing to remove unrelated path: %s\n' "$target" >&2
    exit 1
  fi
}

remove_legacy_direct_alias() {
  local client="$1" source="$ROOT/bin/openshell-client-direct" target="$BIN_DIR/$1-direct"
  if [[ -L "$target" && "$(readlink -f -- "$target")" == "$source" ]]; then
    rm -- "$target"
    printf 'removed obsolete %s\n' "$target"
  fi
}

install_pi_update_shim() {
  local source="$ROOT/bin/pi-openshell" target="$BIN_DIR/pi" backend backend_file="$CONFIG_DIR/pi.backend" replacement
  if [[ -L "$target" && "$(readlink -f -- "$target")" == "$source" ]]; then
    printf 'pi already launches OpenShell: %s\n' "$target"
    return
  fi
  [[ -L "$target" ]] || { printf 'install-openshell-client-launchers: refusing to replace existing path: %s\n' "$target" >&2; exit 1; }
  backend="$(readlink -f -- "$target")"
  case "$backend" in
    "$DATA_HOME"/pi-openshell/*/bin/pi) ;;
    *) printf 'install-openshell-client-launchers: refusing non-package Pi launcher: %s\n' "$backend" >&2; exit 1 ;;
  esac
  [[ -f "$backend" && ! -L "$backend" && -x "$backend" ]] || { printf 'install-openshell-client-launchers: invalid Pi launcher: %s\n' "$backend" >&2; exit 1; }
  mkdir -p -- "$CONFIG_DIR"
  printf '%s\n' "$backend" >"$backend_file.tmp.$$"
  mv -f -- "$backend_file.tmp.$$" "$backend_file"
  replacement="$BIN_DIR/.pi.openshell.$$"
  ln -s -- "$source" "$replacement"
  mv -Tf -- "$replacement" "$target"
  printf 'installed %s -> %s (delegating normal commands to %s)\n' "$target" "$source" "$backend"
}

uninstall_pi_update_shim() {
  local source="$ROOT/bin/pi-openshell" target="$BIN_DIR/pi" backend_file="$CONFIG_DIR/pi.backend" backend replacement
  [[ -L "$target" && "$(readlink -f -- "$target")" == "$source" ]] || return 0
  [[ -f "$backend_file" && ! -L "$backend_file" ]] || { printf 'install-openshell-client-launchers: Pi backend is missing: %s\n' "$backend_file" >&2; exit 1; }
  IFS= read -r backend <"$backend_file" || true
  case "$backend" in "$DATA_HOME"/pi-openshell/*/bin/pi) ;; *) printf 'install-openshell-client-launchers: invalid Pi backend: %s\n' "$backend" >&2; exit 1;; esac
  [[ -f "$backend" && ! -L "$backend" && -x "$backend" ]] || { printf 'install-openshell-client-launchers: invalid Pi backend: %s\n' "$backend" >&2; exit 1; }
  replacement="$BIN_DIR/.pi.backend.$$"
  ln -s -- "$backend" "$replacement"
  mv -Tf -- "$replacement" "$target"
  rm -- "$backend_file"
  printf 'restored %s -> %s\n' "$target" "$backend"
}

case "$action" in
  install)
    mkdir -p -- "$BIN_DIR"
    check_install_target claude
    check_install_target codex
    for client in pi claude codex; do remove_legacy_direct_alias "$client"; done
    install_pi_update_shim
    install_launcher claude
    install_launcher codex
    ;;
  uninstall)
    for client in pi claude codex; do remove_legacy_direct_alias "$client"; done
    uninstall_pi_update_shim
    uninstall_launcher claude
    uninstall_launcher codex
    ;;
  *)
    printf 'usage: install-openshell-client-launchers [install|uninstall]\n' >&2
    exit 2
    ;;
esac
