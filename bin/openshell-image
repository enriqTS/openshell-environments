#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
VERSION="$(<"$ROOT/VERSION")"
REGISTRY="${OPENSHELL_IMAGE_REGISTRY:-localhost/openshell-environments}"
BASE_IMAGE="${OPENSHELL_BASE_IMAGE:-$REGISTRY/base:$VERSION}"
PI_IMAGE="${PI_OPENSHELL_IMAGE:-$REGISTRY/pi:$VERSION}"
CLAUDE_IMAGE="${CLAUDE_OPENSHELL_IMAGE:-$REGISTRY/claude:$VERSION}"
CODEX_IMAGE="${CODEX_OPENSHELL_IMAGE:-$REGISTRY/codex:$VERSION}"

revision() {
  git -C "$1" rev-parse HEAD 2>/dev/null || printf unknown
}

require_docker() {
  command -v docker >/dev/null 2>&1 || {
    printf 'openshell-image: docker is required\n' >&2
    exit 127
  }
}

require_clean() {
  local repository="$1"
  [[ -z "$(git -C "$repository" status --porcelain --untracked-files=normal)" ]] || {
    printf 'openshell-image: commit or remove changes before building: %s\n' "$repository" >&2
    exit 1
  }
}

require_cli_version() {
  local version="$1"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]] || {
    printf 'openshell-image: invalid resolved CLI version: %s\n' "$version" >&2
    exit 2
  }
}

verify_pi_toolchain() {
  # Run through the image entrypoint under the same restricted PATH and
  # omitted ENV that OpenShell gives Pi. A successful build alone cannot
  # detect lost image ENV, and npm/uv only fail on operations that write to
  # their cache (a bare --version can succeed even when the cache dir would
  # resolve to the read-only home), so exercise a real write for each.
  docker run --rm \
    -e PATH=/usr/local/bin:/usr/bin:/bin \
    -e RUSTUP_HOME= \
    -e CARGO_HOME= \
    -e npm_config_cache= \
    -e UV_CACHE_DIR= \
    -e COREPACK_HOME= \
    "$PI_IMAGE" /bin/sh -ec '
      test "$RUSTUP_HOME" = /usr/local/rustup
      test "$CARGO_HOME" = /tmp/cargo
      cargo --version
      rustc --version
      cargo fmt --version
      cargo clippy --version
      mkdir -p /tmp/verify-npm && cd /tmp/verify-npm
      npm init -y >/dev/null
      npm install --no-audit --no-fund lodash >/dev/null
      test -d node_modules/lodash
      uv --version
    '
}

build_base() {
  require_docker
  require_clean "$ROOT"
  docker buildx build --pull --load \
    --build-arg "OPENSHELL_ENVIRONMENTS_VERSION=$VERSION" \
    --build-arg "OPENSHELL_ENVIRONMENTS_REVISION=$(revision "$ROOT")" \
    -t "$BASE_IMAGE" "$ROOT/base"
}

fetch_pi_assets_release() {
  local version="$1" dest="$2"
  local base="https://github.com/enriqTS/pi-customizations/releases/download/pi-assets-v${version}"
  curl -fsSL -o "$dest/pi-assets-${version}.tar.gz" "$base/pi-assets-${version}.tar.gz"
  curl -fsSL -o "$dest/SHA256SUMS" "$base/SHA256SUMS"
  (cd "$dest" && sha256sum -c --ignore-missing SHA256SUMS)
}

verify_resolved_version() {
  local client="$1" expected="$2" output="$3"
  printf '%s\n' "$output"
  [[ "$expected" == latest || "$output" == *"$expected"* ]] || {
    printf 'openshell-image: %s image reports %s, expected %s\n' "$client" "$output" "$expected" >&2
    exit 1
  }
}

build_client() {
  local client="$1" image="$2" cli_version="${3:-latest}" cli_version_arg version_output
  [[ "$cli_version" == latest ]] || require_cli_version "$cli_version"
  case "$client" in
    claude) cli_version_arg=CLAUDE_CLI_VERSION ;;
    codex) cli_version_arg=CODEX_CLI_VERSION ;;
    *) printf 'openshell-image: unsupported client: %s\n' "$client" >&2; exit 2 ;;
  esac
  require_docker
  require_clean "$ROOT"
  docker image inspect "$BASE_IMAGE" >/dev/null 2>&1 || {
    printf 'openshell-image: base image is absent; run: %q build base\n' "$0" >&2
    exit 1
  }
  docker buildx build --load \
    --build-arg "BASE_IMAGE=$BASE_IMAGE" \
    --build-arg "OPENSHELL_ENVIRONMENTS_VERSION=$VERSION" \
    --build-arg "OPENSHELL_ENVIRONMENTS_REVISION=$(revision "$ROOT")" \
    --build-arg "$cli_version_arg=$cli_version" \
    -t "$image" "$ROOT/clients/$client"
  if [[ "$client" == codex ]]; then
    version_output="$(docker run --rm -e HOME=/home/codex "$image" codex-openshell-entrypoint --version)"
  else
    version_output="$(docker run --rm -e HOME="/home/$client" "$image" "$client" --version)"
  fi
  verify_resolved_version "$client" "$cli_version" "$version_output"
}

build_pi() {
  require_docker
  local pi_assets_version="${1:-${PI_CUSTOMIZATIONS_ASSETS_VERSION:-}}"
  local cli_version="${2:-latest}"
  [[ "$cli_version" == latest ]] || require_cli_version "$cli_version"
  [[ -n "$pi_assets_version" ]] || { printf 'usage: openshell-image build pi --pi-assets-version VERSION\n' >&2; exit 2; }
  require_clean "$ROOT"
  docker image inspect "$BASE_IMAGE" >/dev/null 2>&1 || {
    printf 'openshell-image: base image is absent; run: %q build base\n' "$0" >&2
    exit 1
  }
  local context="$(mktemp -d)" pi_assets_revision
  trap 'rm -rf -- "$context"' RETURN
  cp "$ROOT/clients/pi/Dockerfile" "$ROOT/clients/pi/pi-openshell-entrypoint" "$ROOT/clients/pi/patch-pi-codex" "$context/"
  # Release builds consume the generic, checksummed asset archive only. Never
  # clone pi-customizations or execute its scripts in this repository.
  fetch_pi_assets_release "$pi_assets_version" "$context"
  pi_assets_revision="$(tar -xOzf "$context/pi-assets-${pi_assets_version}.tar.gz" manifest.json | node -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(0,"utf8")).source.revision)')"
  docker buildx build --load \
    --build-arg "BASE_IMAGE=$BASE_IMAGE" \
    --build-arg "OPENSHELL_ENVIRONMENTS_VERSION=$VERSION" \
    --build-arg "OPENSHELL_ENVIRONMENTS_REVISION=$(revision "$ROOT")" \
    --build-arg "PI_ASSETS_REVISION=$pi_assets_revision" \
    --build-arg "PI_ASSETS_VERSION=$pi_assets_version" \
    --build-arg "PI_CLI_VERSION=$cli_version" \
    -t "$PI_IMAGE" "$context"
  local version_output
  version_output="$(docker run --rm -e HOME=/home/pi "$PI_IMAGE" pi --version)"
  verify_resolved_version pi "$cli_version" "$version_output"
  verify_pi_toolchain
}
command="${1:-}"
case "$command" in
  build)
    target="${2:-}"
    shift 2 || true
    case "$target" in
      base) build_base ;;
      claude|codex)
        cli_version=latest
        while (($#)); do
          case "$1" in
            --cli-version) cli_version="${2:-}"; shift 2 ;;
            *) printf 'openshell-image: unknown argument: %s\n' "$1" >&2; exit 2 ;;
          esac
        done
        [[ "$target" == claude ]] && build_client claude "$CLAUDE_IMAGE" "$cli_version" || build_client codex "$CODEX_IMAGE" "$cli_version"
        ;;
      pi)
        pi_assets_version=""
        cli_version=latest
        while (($#)); do
          case "$1" in
            --pi-assets-version) pi_assets_version="${2:-}"; shift 2 ;;
            --cli-version) cli_version="${2:-}"; shift 2 ;;
            *) printf 'openshell-image: unknown argument: %s\n' "$1" >&2; exit 2 ;;
          esac
        done
        build_pi "$pi_assets_version" "$cli_version"
        ;;
      all)
        pi_assets_version=""
        while (($#)); do
          case "$1" in
            --pi-assets-version) pi_assets_version="${2:-}"; shift 2 ;;
            *) printf 'openshell-image: unknown argument: %s\n' "$1" >&2; exit 2 ;;
          esac
        done
        build_base
        build_pi "$pi_assets_version"
        ;;
      *) printf 'usage: openshell-image build {base|claude|codex|pi|all} [--cli-version VERSION] --pi-assets-version VERSION\n' >&2; exit 2 ;;
    esac
    ;;
  inspect)
    require_docker
    target="${2:-pi}"
    case "$target" in
      base) image="$BASE_IMAGE" ;;
      claude) image="$CLAUDE_IMAGE" ;;
      codex) image="$CODEX_IMAGE" ;;
      pi) image="$PI_IMAGE" ;;
      *) printf 'usage: openshell-image inspect [base|claude|codex|pi]\n' >&2; exit 2 ;;
    esac
    docker image inspect "$image"
    ;;
  cleanup)
    require_docker
    docker image rm "$PI_IMAGE" "$CLAUDE_IMAGE" "$CODEX_IMAGE" "$BASE_IMAGE"
    ;;
  refs)
    printf 'base=%s\nclaude=%s\ncodex=%s\npi=%s\n' "$BASE_IMAGE" "$CLAUDE_IMAGE" "$CODEX_IMAGE" "$PI_IMAGE"
    ;;
  *)
    printf 'usage: openshell-image {build {base|claude|codex|pi|all} [--cli-version VERSION]|inspect [base|claude|codex|pi]|cleanup|refs}\n' >&2
    exit 2
    ;;
esac
